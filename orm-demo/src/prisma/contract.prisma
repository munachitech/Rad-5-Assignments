// use prisma-8

enum Role {
  @@type("pg/text@1")
  ADMIN = "admin"
  USER  = "user"
}

enum Status {
  @@type("pg/text@1")
  TODO        = "todo"
  IN_PROGRESS = "in_progress"
  DONE        = "done"
}

enum Priority {
  @@type("pg/text@1")
  LOW    = "low"
  MEDIUM = "medium"
  HIGH   = "high"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    temporal.updatedAt() @map("updated_at")

  profile    Profile?
  projects   Project[] @relation("OwnedProjects")
  tasks      Task[]    @relation("AssignedTasks")
  ownedTasks Task[]    @relation("OwnedTasks")

  @@map("users")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int      @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")

  owner User   @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([ownerId])
  @@map("projects")
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      Status   @default(TODO)
  priority    Priority @default(MEDIUM)
  projectId   Int      @map("project_id")
  ownerId     Int      @map("owner_id")
  assigneeId  Int?     @map("assignee_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner    User    @relation("OwnedTasks", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee User?   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  tags     TaskTag[]

  @@index([projectId, status])
  @@index([ownerId])
  @@index([assigneeId])
  @@map("tasks")
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Tag {
  id    Int       @id @default(autoincrement())
  label String    @unique
  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId  Int      @map("task_id")
  tagId   Int      @map("tag_id")
  addedAt DateTime @default(now()) @map("added_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}
